# Bullseye Platform - environment variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local. Production secrets live in Vercel encrypted env vars.

# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE (M0-T2)
# Get these from your Supabase project Settings > API.
# https://supabase.com/dashboard/project/{your-project}/settings/api
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct DB connection for Drizzle migrations and server-side queries.
# Format: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE AUTH (M0-T4)
# Magic link sign-in. Resend acts as the SMTP provider; configure in Supabase
# Studio under Authentication > Providers > Email > SMTP Settings.
# Site URL must be set to the deployed URL (e.g. https://app.bullseyeproperties.co.uk).
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# RESEND (M0-T4 dep)
# Transactional email provider. Verify the sender domain (app.bullseyeproperties.co.uk)
# before any email goes out. https://resend.com/api-keys
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# SHARE LINKS (M4)
# Salt for hashing client IPs in the share-link access log (share_token_events).
# Any long random string; keeps logged IPs non-reversible. Rotating it just
# changes future hashes. Share secrets themselves are random per-link (no env).
# ─────────────────────────────────────────────────────────────────────────────
SHARE_LINK_SALT=

# ─────────────────────────────────────────────────────────────────────────────
# TRIGGER.DEV (M0-T6)
# Background jobs runner. Avoids Vercel's 5-minute Server Action ceiling.
# https://trigger.dev/account
# ─────────────────────────────────────────────────────────────────────────────
TRIGGER_API_KEY=
TRIGGER_API_URL=https://api.trigger.dev

# ─────────────────────────────────────────────────────────────────────────────
# ANTHROPIC (M3)
# Use the existing Bullseye Anthropic org. Set a monthly spend cap of £300.
# https://console.anthropic.com/settings/keys
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# Models (defaults set in code; override here if needed).
ANTHROPIC_MODEL_PRIMARY=claude-sonnet-4-7
ANTHROPIC_MODEL_FALLBACK=claude-haiku-4-5

# Kill switch - set to "true" to block all Anthropic calls platform-wide.
CLAUDE_DISABLE=false

# ─────────────────────────────────────────────────────────────────────────────
# MAPBOX (M2)
# Static images API for amenities, flood, and crime maps.
# https://console.mapbox.com/account/access-tokens/
# ─────────────────────────────────────────────────────────────────────────────
MAPBOX_PUBLIC_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# SENTRY (M0-T1)
# Error monitoring across web and Trigger.dev tasks. PII scrubbed before send.
# https://sentry.io/settings/account/api/auth-tokens/
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS (M4)
# Set to "false" to disable live-ship behaviour (Generate button disabled,
# /api/generate returns maintenance message).
# ─────────────────────────────────────────────────────────────────────────────
LIVE_SHIP_ENABLED=true
